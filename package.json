{
  "name": "dollareus",
  "version": "0.1.0",
  "private": true,
  "description": "API-first modular commerce platform for independent businesses",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "api:dev": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "api:start": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "ci": "pnpm build && pnpm api:typecheck",
    "db:setup": "node --env-file=.env --import tsx apps/api/src/db/setup.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^3.25.0",
    "zone.js": "~0.15.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/node": "^22.16.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "@types/pg": "^8.15.5"
  },
  "type": "module"
}