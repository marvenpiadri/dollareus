{
  "name": "dollareus",
  "version": "0.1.0",
  "private": true,
  "description": "API-first modular commerce platform for independent businesses",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 3000",
    "start": "ng serve --host 0.0.0.0 --port 3000",
    "build": "ng build",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "serve:ssr": "node dist/dollareus/server/server.mjs",
    "api:dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "api:start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "ci": "npm run build && npm run api:typecheck",
    "db:setup": "npm run db:migrate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/api/src/db/setup.ts",
    "db:status": "node --env-file-if-exists=.env --import tsx apps/api/src/db/status.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@img/sharp-linux-x64": "^0.35.5",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "rxjs": "~7.8.2",
    "sharp": "^0.34.3",
    "tslib": "^2.8.1",
    "zod": "^3.25.0",
    "zone.js": "~0.15.1",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0"
  }
}
