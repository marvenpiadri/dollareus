# Local development defaults. Do not commit real credentials or secrets.
# Neon pooled PostgreSQL connection string; leave blank until configured locally.
DATABASE_URL=
DATABASE_POOL_MAX=5
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200
# Public hosted storefront URLs use https://{store-slug}.{PUBLIC_STORE_DOMAIN}.
# Configure wildcard DNS and the production hosting project before enabling publicly.
PUBLIC_STORE_DOMAIN=dollareus.com
# CNAME target shown to merchants when they connect a custom domain.
CUSTOM_DOMAIN_CNAME_TARGET=shops.dollareus.com
FIREBASE_PROJECT_ID=demo-dollareus
# Set to the actual default bucket name for media upload intents.
FIREBASE_STORAGE_BUCKET=
# Local emulator options (set only when running the Firebase emulators).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
