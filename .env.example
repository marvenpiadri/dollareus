# Local development defaults. Never commit real credentials or secrets.
# Required Neon PostgreSQL connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200
# Public hosted storefront URLs use https://{store-slug}.{PUBLIC_STORE_DOMAIN}.
PUBLIC_STORE_DOMAIN=dollareus.com
CUSTOM_DOMAIN_CNAME_TARGET=shops.dollareus.com
# First-party authentication email delivery (Resend-compatible API). Required for verification and password recovery.
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_URL=http://localhost:4200
# First-party authentication. Configure OAuth credentials only for providers you enable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/facebook/callback
# Optional frontend URL after successful social sign-in.
AUTH_SUCCESS_REDIRECT_URL=http://localhost:4200

# Neon S3-compatible object storage for product media (configure only on the API server)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=
