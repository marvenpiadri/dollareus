# Local development defaults. Never commit real credentials or secrets.
# Required Neon PostgreSQL connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200
# Public hosted storefront URLs use https://{store-slug}.{PUBLIC_STORE_DOMAIN}.
PUBLIC_STORE_DOMAIN=dollareus.com
CUSTOM_DOMAIN_CNAME_TARGET=shops.dollareus.com
# Firebase is used only for identity verification and object storage, not app data.
FIREBASE_PROJECT_ID=demo-dollareus
FIREBASE_STORAGE_BUCKET=
# Optional Firebase Auth/Storage emulators.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
