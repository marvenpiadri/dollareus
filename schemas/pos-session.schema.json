{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dollareus.com/schemas/pos-session.schema.json",
  "title": "Dollareus POS Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organizationId",
    "storeId",
    "label",
    "terminalType",
    "status",
    "openedBy",
    "openedAt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "terminalType": {
      "enum": [
        "retail",
        "restaurant",
        "service",
        "general"
      ]
    },
    "locationId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "openedBy": {
      "type": "string",
      "minLength": 1
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedBy": {
      "type": "string"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
