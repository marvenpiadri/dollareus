{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dollareus.com/schemas/pos-order.schema.json",
  "title": "Dollareus POS Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organizationId",
    "storeId",
    "sessionId",
    "number",
    "status",
    "channel",
    "fulfillment",
    "currency",
    "subtotal",
    "taxTotal",
    "discountTotal",
    "grandTotal",
    "lines",
    "createdBy",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "confirmed",
        "preparing",
        "ready",
        "completed",
        "cancelled"
      ]
    },
    "channel": {
      "enum": [
        "pos",
        "qr"
      ]
    },
    "fulfillment": {
      "enum": [
        "counter",
        "takeaway",
        "dine_in",
        "delivery",
        "service"
      ]
    },
    "tableLabel": {
      "type": "string",
      "maxLength": 80
    },
    "customerNote": {
      "type": "string",
      "maxLength": 1000
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal": {
      "$ref": "#/$defs/money"
    },
    "taxTotal": {
      "$ref": "#/$defs/money"
    },
    "discountTotal": {
      "$ref": "#/$defs/money"
    },
    "grandTotal": {
      "$ref": "#/$defs/money"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceType",
          "itemId",
          "nameSnapshot",
          "quantity",
          "unitPrice",
          "lineTotal"
        ],
        "properties": {
          "sourceType": {
            "enum": [
              "product",
              "menuItem"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "variantId": {
            "type": "string"
          },
          "menuId": {
            "type": "string"
          },
          "nameSnapshot": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "$ref": "#/$defs/money"
          },
          "lineTotal": {
            "$ref": "#/$defs/money"
          }
        }
      }
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
